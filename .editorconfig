root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_filename = enabled
# Allow Composable functions to start with an uppercase letter.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview

[*.{xml,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
